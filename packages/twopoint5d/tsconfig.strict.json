{
  // Checks only, emits nothing: the two switches hold here for all of `src`, while
  // `tsconfig.json` and the emitting build over `tsconfig.build.json` run without them.
  // This file goes away once both switches sit in `tsconfig.json` itself.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src"]
}
