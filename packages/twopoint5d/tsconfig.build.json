{
  // `pnpm build` emits what npm gets, and the package ships `dist/` without `src/`. A
  // declaration map or a source map would point at `src/`, so the build writes neither.
  // The benches and `src/testing/` are test infrastructure and belong in `dist/` as little as
  // the specs do.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declarationMap": false,
    "sourceMap": false
  },
  "exclude": ["**/*.spec.ts", "**/*.bench.ts", "src/testing"]
}
