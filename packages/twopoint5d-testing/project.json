{
  "name": "twopoint5d-testing",
  "tags": ["browser", "twopoint5d"],
  "root": "packages/twopoint5d-testing",
  "targets": {
    "test": {
      "inputs": ["default", {"dependentTasksOutputFiles": "**/*", "transitive": true}]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "{projectRoot}/test/**/*.js",
        "{projectRoot}/package.json",
        "sharedTsconfigs",
        "{workspaceRoot}/**/*.md",
        "{workspaceRoot}/scripts/checkDocSnippets.mjs",
        "{workspaceRoot}/scripts/checkDocSnippets/*.mjs",
        "!{workspaceRoot}/scripts/checkDocSnippets/*.test.mjs",
        {"dependentTasksOutputFiles": "**/*", "transitive": true}
      ]
    }
  }
}
