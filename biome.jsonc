{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": {"enabled": true, "clientKind": "git", "useIgnoreFile": true},
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/bench-results",
      "!**/test-results",
      // generated by `astro sync`, never hand-edited
      "!**/.astro",
      // vendored build output, kept byte-for-byte as shipped; RainbowLine from
      // @spearwolf/astro-rainbow-line loads it at runtime, so it is not dead weight even
      // though nothing in the repo references it (see AGENTS.md)
      "!apps/lookbook/public/js",
      // report artifact, rewritten wholesale by its generator
      "!audit.html",
      // image assets, exported by the tools that drew them
      "!**/*.svg",
      "!.vscode"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 130,
    "bracketSpacing": false
  },
  "javascript": {
    "formatter": {"quoteStyle": "single", "trailingCommas": "all"}
  },
  "css": {
    // global.css of the lookbook is Tailwind 4: `@theme`, `@apply` and friends
    "parser": {"tailwindDirectives": true},
    "formatter": {"quoteStyle": "single"},
    // the stylesheets are formatted, not linted: a second `background` is the fallback
    // of the gradient that follows it
    "linter": {"enabled": false}
  },
  "html": {
    // formats the .astro files whole and lints their frontmatter and <script> blocks
    "experimentalFullSupportEnabled": true,
    "formatter": {"enabled": true, "indentScriptAndStyle": true, "selfCloseVoidElements": "always"}
  },
  // the imports keep the order their authors gave them
  "assist": {
    "actions": {"source": {"organizeImports": "off"}}
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "error",
        "noTsIgnore": "error",
        // `any` stays allowed outside the published library code: the specs put their
        // renderer in with `as any`, and the lookbook demos are no API. An override below
        // holds the library code to it.
        "noExplicitAny": "off",
        // an interface merged into the class of the same name is how a class takes on the
        // members of `eventize()` and of a vertex object
        "noUnsafeDeclarationMerging": "off",
        // `a == b` where both may be `null` or `undefined` treats the two as one
        "noDoubleEquals": "off",
        // `forEach((x) => set.add(x))` is a one-liner, not a lost return value
        "useIterableCallbackReturn": "off",
        // `(this.#x ??= …)` and the like build their value where they use it
        "noAssignInExpressions": "off",
        // `T | void` is the return type of a callback that may answer something or nothing
        "noConfusingVoidType": "off"
      },
      "style": {
        "useImportType": "error",
        // under `noUncheckedIndexedAccess` (root tsconfig.json) an index access carries
        // `undefined` in its type. `arr[i]!` in a loop bounded by `arr.length` is how the
        // hot paths say that the index is in range, without a branch per element.
        "noNonNullAssertion": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/*.ts", "*.ts"],
                "message": "Relative imports carry the .js suffix (NodeNext) — a .ts suffix is written unchanged into the published .d.ts."
              }
            ]
          }
        }
      },
      "complexity": {
        // `noPropertyAccessFromIndexSignature` (root tsconfig.json) asks for `obj['key']`
        // wherever the key comes from an index signature
        "useLiteralKeys": "off",
        "useArrowFunction": "off",
        "useOptionalChain": "off",
        "noUselessThisAlias": "off",
        // `VOUtils`, `TexturePackerJson` and `Stylesheets` are public API
        "noStaticOnlyClass": "off",
        // a `case` that falls into `default` names a value the switch knows about
        "noUselessSwitchCase": "off",
        "noUselessUndefinedInitialization": "off",
        "noUselessContinue": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      // a promise nobody awaits or catches loses its rejection, in a spec as much as in the
      // library; both rules read the types Biome infers for the expressions. They hold
      // packages/*/src only, an override below takes them off everywhere else. Biome runs
      // its type inference only for a rule switched on up here, not for one an override
      // switches on.
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "overrides": [
    {
      // the published library code: its types reach every consumer, so an `any` there needs
      // its reason on the spot; specs, benches and src/testing/ never ship
      "includes": [
        "packages/*/src/**/*.ts",
        "!packages/*/src/**/*.spec.ts",
        "!packages/*/src/**/*.bench.ts",
        "!packages/*/src/testing/**"
      ],
      "linter": {"rules": {"suspicious": {"noExplicitAny": "error"}}}
    },
    {
      // the markup and the <style> blocks of the lookbook pages are formatted, not linted:
      // the lookbook is a showcase of the library, and a second `background` is the
      // fallback of the gradient that follows it
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "a11y": "off",
          "security": {"noBlankTarget": "off"},
          "style": {"noDescendingSpecificity": "off"},
          "suspicious": {"noDuplicateProperties": "off"}
        }
      }
    },
    {
      "includes": ["**", "!packages/*/src/**"],
      "linter": {"rules": {"nursery": {"noFloatingPromises": "off", "noMisusedPromises": "off"}}}
    },
    {
      // the Node scripts report on stdout and stderr, and the browser tests log what a
      // failing GPU run needs to be understood
      "includes": ["**/*.mjs", "**/*.test.js"],
      "linter": {"rules": {"suspicious": {"noConsole": "off"}}}
    }
  ]
}
