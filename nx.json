{
  "defaultBase": "main",
  "parallel": 6,
  "tui": {
    "enabled": false
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-script",
      "dependsOn": ["^build"],
      "options": {
        "script": "test"
      },
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-script",
      "options": {
        "script": "typecheck"
      },
      "cache": true
    },
    "checkPkgTypes": {
      "executor": "nx:run-script",
      "dependsOn": ["build"],
      "options": {
        "script": "checkPkgTypes"
      }
    },
    "checkNameableTypes": {
      "executor": "nx:run-script",
      "dependsOn": ["build"],
      "options": {
        "script": "checkNameableTypes"
      }
    },
    "lintPkg": {
      "executor": "nx:run-script",
      "dependsOn": ["build"],
      "options": {
        "script": "lintPkg"
      }
    },
    "publishNpmPkg": {
      "executor": "nx:run-script",
      "dependsOn": ["build"],
      "options": {
        "script": "publishNpmPkg"
      }
    }
  },
  "namedInputs": {
    "sharedTsconfigs": ["{projectRoot}/tsconfig.json", "{workspaceRoot}/tsconfig.json"],
    "makePackageJson": [
      "{projectRoot}/package.json",
      "{projectRoot}/package.override.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/scripts/makePackageJson.mjs",
      "{workspaceRoot}/scripts/makePackageJson/*.mjs",
      "!{workspaceRoot}/scripts/makePackageJson/*.test.mjs",
      "{workspaceRoot}/pnpm-workspace.yaml"
    ],
    "vitestDefaults": [
      "{projectRoot}/vite.config.js",
      "{projectRoot}/vite.config.ts",
      "{projectRoot}/vite.config.mjs",
      "{projectRoot}/package.json",
      "sharedTsconfigs",
      {
        "externalDependencies": ["vitest", "@vitest/coverage-v8", "three", "@spearwolf/eventize", "@spearwolf/signalize", "sinon"]
      }
    ]
  },
  "analytics": false
}
