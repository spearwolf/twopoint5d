{
  "name": "lookbook",
  "tags": ["app"],
  "root": "apps/lookbook",
  "targets": {
    "dev": {
      "dependsOn": ["^build"]
    },
    "start": {
      "dependsOn": ["^build"]
    },
    "preview": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/src/**/*.astro",
        "{projectRoot}/src/**/*.json",
        "{projectRoot}/astro.config.mjs",
        "sharedTsconfigs",
        "^default"
      ]
    }
  }
}
