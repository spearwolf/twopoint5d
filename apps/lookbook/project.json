{
  "name": "lookbook",
  "tags": ["app", "ci"],
  "root": "apps/lookbook",
  "targets": {
    "dev": {
      "dependsOn": ["^build"]
    },
    "start": {
      "dependsOn": ["^build"]
    },
    "preview": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/src/**/*.astro",
        "{projectRoot}/src/**/*.json",
        "{projectRoot}/assets-src/**/*.mjs",
        "{projectRoot}/assets-src/tsconfig.json",
        "{projectRoot}/astro.config.mjs",
        "{projectRoot}/package.json",
        "sharedTsconfigs",
        {"dependentTasksOutputFiles": "**/*", "transitive": true}
      ]
    },
    "build": {
      "inputs": ["default", {"dependentTasksOutputFiles": "**/*", "transitive": true}]
    },
    "test": {
      "inputs": [
        "vitestDefaults",
        "{projectRoot}/vitest.config.ts",
        "{projectRoot}/src/**/*",
        {"dependentTasksOutputFiles": "**/*", "transitive": true}
      ]
    },
    "coverage": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "vitestDefaults",
        "{projectRoot}/vitest.config.ts",
        "{projectRoot}/src/**/*",
        {"dependentTasksOutputFiles": "**/*", "transitive": true}
      ],
      "outputs": ["{projectRoot}/coverage"]
    }
  }
}
