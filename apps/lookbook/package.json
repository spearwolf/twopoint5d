{
  "name": "lookbook",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm exec astro dev",
    "start": "pnpm exec astro dev",
    "build": "pnpm exec astro build",
    "preview": "pnpm exec astro preview",
    "postinstall": "pnpm exec astro telemetry disable",
    "typecheck": "pnpm run astro:check && pnpm run assets:check",
    "astro:check": "pnpm exec astro check",
    "assets:check": "pnpm exec tsc -p assets-src/tsconfig.json",
    "astro": "pnpm exec astro"
  },
  "dependencies": {
    "@spearwolf/astro-rainbow-line": "^2.1.0",
    "@spearwolf/eventize": "catalog:",
    "@spearwolf/signalize": "catalog:",
    "@spearwolf/twopoint5d": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "lil-gui": "^0.21.0",
    "marked": "^18.1.1",
    "tailwindcss": "^4.3.3",
    "three": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
