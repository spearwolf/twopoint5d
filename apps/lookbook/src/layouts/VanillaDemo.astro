---
import DemoNavBar from '~components/DemoNavBar.astro';
import {FULLSCREEN_CANVAS_ID} from '~demos/utils/fullscreenCanvas';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  /** Write a `<canvas>` that fills the window, for `getFullscreenCanvas()` to pick up. */
  fullscreenCanvas?: boolean;
}

const {title, description, fullscreenCanvas = false} = Astro.props;

// The layers of a demo, bottom to top: the canvas, the blur and the rainbow line of the
// DemoNavBar, the <demo-ui> of the page, the logo and the title of the DemoNavBar, and the
// dialog in the top layer. A page puts the HTML it shows over its canvas into one <demo-ui>:
// its in-flow content starts below the navbar, its positioned content keeps clear of the navbar
// through --demo-nav-bar-height, which ?ui=0 sets to 0px.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/lookbook/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>2.5d lookbook &#x2022; {title} demo</title>
    <script is:inline>
      // ?ui=0 hides the chrome of the lookbook around the demo, for a demo embedded in an
      // iframe; ?preview=1 is the page `pnpm lookbook:generate-previews` takes its screenshot
      // of, without the chrome and without the <demo-ui> either. Both are set before the
      // first paint, so nothing flashes up. A block: a classic script's top-level const would
      // land in the global scope of the page
      {
        const params = new URLSearchParams(location.search);
        const preview = params.get('preview') === '1';
        if (preview || params.get('ui') === '0') {
          document.documentElement.dataset.demoUi = 'off';
        }
        if (preview) {
          document.documentElement.dataset.demoPreview = 'on';
        }
      }
    </script>
  </head>
  <body class:list={{'fullscreen-canvas': fullscreenCanvas}}>
    <DemoNavBar title={title} description={description} />
    {fullscreenCanvas && <canvas id={FULLSCREEN_CANVAS_ID} resize-to="window" />}
    <slot />
    <script>
      import {armPreviewTimeout} from '~demos/utils/demoPreview';

      // the default moment of the preview screenshot; a demo takes it over with deferPreview()
      armPreviewTimeout();
    </script>
  </body>
</html>

<style is:global>
  /* the room the DemoNavBar overlay takes at the top, for a page that keeps its content clear of it */
  :root {
    --demo-nav-bar-height: 4rem;
    --demo-nav-bar-rainbow-line-height: 3px;
  }
  :root[data-demo-ui='off'] {
    --demo-nav-bar-height: 0px;
    --demo-nav-bar-rainbow-line-height: 0px;
  }
  /* the canvas stays at z-index auto, below all three */
  :root {
    --demo-layer-nav-bar: 10;
    --demo-layer-ui: 20;
    --demo-layer-title: 30;
  }
  /* in a layer, so the Tailwind utilities on a child still win over the pointer-events here */
  @layer components {
    /* a glass pane over the whole window: only its children catch the pointer, everywhere else
       the events fall through to the canvas */
    demo-ui {
      display: block;
      position: fixed;
      inset: 0;
      z-index: var(--demo-layer-ui);
      padding-top: var(--demo-nav-bar-height);
      pointer-events: none;
    }
    demo-ui > * {
      pointer-events: auto;
    }
  }
  /* ?preview=1: the screenshot shows what the demo draws, not the panels and buttons over it.
     Outside the layer, so it wins over the display: block in there */
  :root[data-demo-preview='on'] demo-ui {
    display: none;
  }
  /* a lil-gui panel that a demo hands the <demo-ui> as its container: in the top right corner,
     where autoPlace would put it, but below the navbar on a narrow screen, where the title would
     run over it, and right below the rainbow line on a wider one. Outside the layer, the
     stylesheet that lil-gui injects is none either */
  demo-ui > .lil-gui.lil-root {
    --lil-gui-top: var(--demo-nav-bar-height);
    position: absolute;
    top: var(--lil-gui-top);
    right: 15px;
    max-height: calc(100% - var(--lil-gui-top));
  }
  @media (width >= 48rem) {
    demo-ui > .lil-gui.lil-root {
      --lil-gui-top: var(--demo-nav-bar-rainbow-line-height);
    }
  }
  /* the dropdown of a select is drawn by the browser: dark like the panel, in the colors of lil-gui */
  demo-ui > .lil-gui.lil-root {
    color-scheme: dark;
  }
  demo-ui > .lil-gui.lil-root option {
    background-color: var(--widget-color);
    color: var(--text-color);
  }
  html {
    font-family: system-ui, sans-serif;
    background-color: #232348;
  }
  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }
  /* global: the <body> is written here, and Astro hoists no <style> under a condition */
  body.fullscreen-canvas {
    height: 100vh;
    overflow-y: hidden;
  }
  /* the buttons a demo page puts over its canvas */
  .actionBtn {
    padding: 0.5em;
    background-color: rgba(50 20 90 / 60%);
    color: #eee;
    border-radius: 4px;
    border: 1px solid rgba(11, 15, 17);
    box-shadow: 4px 4px 0 rgba(11, 15, 17);
    font-size: 100%;
    font-weight: bold;
    cursor: pointer;
    display: inline-flex;
  }
  .actionBtn:hover {
    background-color: rgba(90 50 180 / 70%);
    color: #fff;
    user-select: none;
  }
</style>
