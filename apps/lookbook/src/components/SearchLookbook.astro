---
import CloseDialogIcon from './icons/CloseDialogIcon.astro';
import SearchIcon from './icons/SearchIcon.astro';
import RainbowLine from '@spearwolf/astro-rainbow-line';
import {RAINBOW_COLORS} from './rainbowColors';
---

<button class="open-search-dialog-action inline-flex flex-row items-start justify-center gap-2">
  <SearchIcon />
  <span class="leading-[2]">Ctrl K</span>
</button>

<dialog class="search-lookbook-dialog m-auto max-w-xl px-6 py-4 rounded-md backdrop-blur-xs">
  <header class="flex flex-row items-center justify-end mb-4">
    <button aria-label="close search">
      <CloseDialogIcon />
    </button>
  </header>

  <section class="mb-4">
    <h1 class="text-l">Search lookbook</h1>
    <RainbowLine colorSliceWidth={8} cycleDirection="left" cycleColors={RAINBOW_COLORS} />
  </section>

  <section class="search-body mb-4 text-sm text-slate-200">
    <input
      type="search"
      class="search-input"
      aria-label="search the demos by title, tag or description"
      placeholder="sprite, Map2D, instanced …"
      autocomplete="off"
      autofocus
    />
    <ul class="search-results mt-4"></ul>
    <p class="search-no-results mt-4 hidden">No demo matches every word.</p>
  </section>
</dialog>

<style>
  .open-search-dialog-action {
    color: var(--color-primary);
    background-color: var(--color-background-dark);
    box-shadow: 0 0 1px 1px var(--color-background-light);
    font-size: var(--tag-font-size);
    padding: 0.2em 0.8em 0.2em 0.3em;
    border-radius: 2em;
  }

  .open-search-dialog-action:is(:hover, :focus-within) {
    box-shadow: 0 0 1px 1px var(--color-primary-highlight);
  }

  /* centered by the m-auto of the markup, which Tailwind's preflight would reset; it floats with
     a generous margin to the edges of the window and, when the results grow taller than that
     leaves room for, scrolls the result list and keeps the header and the search field in view */
  .search-lookbook-dialog {
    --search-dialog-float: clamp(1rem, 7vh, 5rem);
    width: calc(100% - 2rem);
    max-height: calc(100dvh - 2 * var(--search-dialog-float));
    background-color: rgba(18 22 25 / 75%);
    color: #fff;
    outline: 1px solid #e5e500;
    box-shadow: 0 0 2px 3px rgba(0 0 0 / 20%);
    text-shadow: none;
  }

  .search-lookbook-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .search-body {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .search-input {
    width: 100%;
    padding: 0.4em 0.8em;
    color: #fff;
    background-color: rgba(0 0 0 / 40%);
    border-radius: 0.3em;
    box-shadow: 0 0 1px 1px var(--color-primary-inactive);
  }

  .search-input:focus {
    outline: none;
    box-shadow: 0 0 1px 1px #e5e500;
  }

  .search-results {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* the transparent border keeps the items from shifting when the active one shows its frame */
  .search-results :global(li) {
    padding: 0.3em 0.6em;
    border: 1px solid transparent;
    border-radius: 0.3em;
  }

  /* the title link carries the focus, the frame wraps the whole item including its tags */
  .search-results :global(li:has(> a:is(:hover, :focus))) {
    border-color: #e5e500;
    background-color: rgba(229 229 0 / 12%);
  }

  .search-results :global(a) {
    color: var(--color-primary-highlight);
    font-weight: 600;
  }

  .search-results :global(a:is(:hover, :focus)) {
    color: #e5e500;
    outline: none;
  }

  /* Enter opens the first result */
  .search-results :global(li:first-child > a::after) {
    content: ' ⏎';
    color: var(--color-primary-inactive);
  }

  .search-results :global(.search-result-tags) {
    display: block;
    font-size: var(--tag-font-size);
    color: var(--color-primary);
  }

  .search-lookbook-dialog::backdrop {
    background: rgb(187, 0, 51);
    background: linear-gradient(
      22deg,
      rgba(187, 0, 51, 0.66) 0%,
      rgba(143, 0, 132, 0.66) 13%,
      rgba(8, 101, 92, 0.66) 61%,
      rgba(0, 96, 102, 0.66) 64%,
      rgba(0, 35, 97, 0.66) 86%,
      rgba(0, 2, 102, 0.66) 100%
    );
    backdrop-filter: blur(2px);
  }
</style>

<script>
  import type {IDemo} from '~demos/utils/loadMetadataForDemos';
  import {searchDemos} from './searchDemos';

  // the page that carries the header writes LookbookMetadata next to it,
  // see pages/index.astro
  const metadata = document.getElementById('lookbook-metadata');
  if (!metadata) {
    throw new Error('[lookbook] SearchLookbook: the page has no #lookbook-metadata element, write LookbookMetadata next to it');
  }
  const demos: IDemo[] = JSON.parse(metadata.dataset['lookbookDemos'] ?? '[]');

  // the dialog, its close button, the search field and the result list are written by the
  // markup of this component
  const dialog = document.querySelector<HTMLDialogElement>('dialog.search-lookbook-dialog')!;
  const closeButton = dialog.querySelector('button')!;
  const input = dialog.querySelector<HTMLInputElement>('input.search-input')!;
  const resultList = dialog.querySelector<HTMLUListElement>('ul.search-results')!;
  const noResults = dialog.querySelector<HTMLParagraphElement>('p.search-no-results')!;
  const showButtons = document.querySelectorAll('button.open-search-dialog-action');

  let results: IDemo[] = [];

  function renderResults() {
    results = searchDemos(demos, input.value);

    const items = results.map((demo) => {
      const link = document.createElement('a');
      link.href = demo.href;
      link.textContent = demo.title;

      const item = document.createElement('li');
      item.append(link);

      if (demo.tags?.length) {
        const tags = document.createElement('span');
        tags.className = 'search-result-tags';
        tags.textContent = demo.tags.join(' · ');
        item.append(tags);
      }
      return item;
    });

    resultList.replaceChildren(...items);
    noResults.classList.toggle('hidden', results.length > 0);
  }

  function openSearch() {
    if (!dialog.open) {
      renderResults();
      dialog.showModal();
    }
    input.focus();
    input.select();
  }

  for (const showButton of showButtons) {
    showButton.addEventListener('click', openSearch);
  }

  closeButton.addEventListener('click', () => {
    dialog.close();
  });

  input.addEventListener('input', renderResults);

  input.addEventListener('keydown', (event) => {
    // an Enter that picks a word in an IME composition belongs to the composition, not to
    // the search. 229 is the keyCode of a keydown the IME has taken; a browser that ends
    // the composition before that keydown reports it with isComposing false
    if (event.isComposing || event.keyCode === 229) return;

    const first = results[0];
    if (event.key === 'Enter' && first) {
      event.preventDefault();
      window.location.assign(first.href);
    }
  });

  // Ctrl+K, and Cmd+K on a Mac; Escape closes the modal dialog by itself
  document.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && !event.altKey && !event.shiftKey && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openSearch();
    }
  });
</script>
