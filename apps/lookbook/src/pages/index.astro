---
import DemoCardsGrid from '~components/DemoCardsGrid.astro';
import LookbookHeader from '~components/LookbookHeader.astro';
import LookbookMetadata from '~components/LookbookMetadata.astro';
import TagCloudFilter from '~components/TagCloudFilter.astro';
import Layout from '~layouts/Layout.astro';
import backPattern from '../images/ball-pattern-dark-blueish-4x-30deck-doubled.webp?url';
---

<Layout title="2.5d lookbook">
  <div class="back-pattern">
    <LookbookHeader />
    <LookbookMetadata />

    <div class="grid grid-cols-only-content lg:grid-cols-sidebar-content">
      {/* below the lg breakpoint the filter sits on top of the demos, from lg on it is a sidebar */}
      <div class="lg:sticky lg:top-0">
        <div class="lg:sticky lg:top-16 lg:h-[calc(100vh-4rem)] flex flex-col">
          <div class="lg:overflow-y-auto px-5 sm:px-12 lg:px-2 no-bg-scrollbar lg:w-[400px] grow overscroll-contain">
            <aside class="lg:grow flex-col w-full z-10">
              <nav class="w-full pt-4 lg:h-auto grow pe-0 lg:pe-5 lg:pb-16">
                <TagCloudFilter />
              </nav>
            </aside>
          </div>
        </div>
      </div>
      <main class="isolate">
        <div class="mt-8 lg:mt-4 mb-16 px-5 sm:px-12">
          <div class="mx-auto pt-4 pb-6">
            <DemoCardsGrid />
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>

<style define:vars={{'page-background-pattern': `url(${backPattern})`}}>
  .back-pattern {
    background-color: var(--color-background);
    background-image: var(--page-background-pattern);
  }
</style>
