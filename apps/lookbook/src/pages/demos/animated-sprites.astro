---
import Layout from '~layouts/VanillaDemo.astro';
import {description, title} from './_animated-sprites.json';
---

<Layout title={title} description={description} fullscreenCanvas>
  <demo-ui>
    <section
      class="fixed top-[calc(var(--demo-nav-bar-height)+1rem)] right-4 flex flex-wrap gap-1 items-center content-center justify-center"
    >
      <div class="actionBtn lessSprites">less</div>
      <div class="spriteCount">0</div>
      <div class="actionBtn moreSprites">more</div>
    </section>
  </demo-ui>
</Layout>

<style>
  body {
    background: radial-gradient(circle, rgb(118, 174, 141) 0%, rgb(13, 77, 75) 80%, rgb(3, 11, 28) 100%);
    color: #eee;
  }
  .spriteCount {
    color: #eee;
    font-weight: bold;
    font-size: 250%;
    min-width: 3em;
    text-align: center;
  }
</style>

<script>
  import {on} from '@spearwolf/eventize';
  import {
    AnimatedSpriteKind,
    FeatureSprites,
    FeatureSpritesGeometry,
    FeatureSpritesMaterial,
    OnDisplayRenderFrame,
    TextureStore,
  } from '@spearwolf/twopoint5d';
  import {BouncingSprites} from '~demos/animated-sprites/BouncingSprites';
  import {PerspectiveOrbitDemo} from '~demos/utils/PerspectiveOrbitDemo';
  import assetsUrl from '~demos/utils/assetsUrl';
  import {onDemoInit} from '~demos/utils/demoInit';
  import {getFullscreenCanvas} from '~demos/utils/fullscreenCanvas';

  const demo = new PerspectiveOrbitDemo(getFullscreenCanvas());

  // the .spriteCount readout is written by the markup of this very page
  const renderSpriteCount = (count: number) => {
    document.querySelector('.spriteCount')!.textContent = count.toString();
  };

  onDemoInit(demo, 'animated-sprites', async ({renderer}) => {
    const {scene, camera} = demo;
    camera.position.z = 60;

    const CAPACITY = 3000;
    const INITIAL_SPRITE_COUNT = 500;

    const store = new TextureStore(renderer);

    on(store, 'error', ({source, url, id, error}) => {
      // biome-ignore lint/suspicious/noConsole: the demo logs to the devtools on purpose
      console.error(`[animated-sprites] TextureStore ${source} failed for ${url ?? id}`, error);
    });

    // biome-ignore lint/suspicious/noConsole: the demo logs to the devtools on purpose
    console.log('loading textures...', store);

    const [texture, frameBasedAnimations] = await store
      .loadAsync(assetsUrl('nobingers.json'))
      .then(() => store.getAsync('nobingers', ['texture', 'frameBasedAnimations']))
      .catch((error: unknown) => {
        // a loader that fails disposes the store it built
        store.dispose();
        throw error;
      });
    // a dispose() while the assets loaded has gone out already: nothing is built
    if (demo.isDisposed) {
      store.dispose();
      return;
    }

    const geometry = new FeatureSpritesGeometry(AnimatedSpriteKind, CAPACITY);

    const bouncingSprites = new BouncingSprites(geometry.instancedPool, 500, 75, 7);

    bouncingSprites.startSpeedBaseX = 10;
    bouncingSprites.startSpeedX = 50;

    const animId = frameBasedAnimations.animId('anim0');

    bouncingSprites.createSprites(INITIAL_SPRITE_COUNT, animId);

    renderSpriteCount(INITIAL_SPRITE_COUNT);

    // bakeDataTexture() hands its texture over to this page
    const animsMap = frameBasedAnimations.bakeDataTexture({renderer});
    const material = new FeatureSpritesMaterial(AnimatedSpriteKind, {
      textures: {colorMap: texture, animsMap},
      depthTest: false,
      depthWrite: false,
    });

    const mesh = new FeatureSprites(AnimatedSpriteKind, {geometry, material});

    scene.add(mesh);

    on(demo, OnDisplayRenderFrame, ({deltaTime, now}) => {
      bouncingSprites.animate(deltaTime);
      material.setUniform('time', now);
      mesh.update();
    });

    // biome-ignore lint/suspicious/noConsole: the demo logs to the devtools on purpose
    console.log('BouncingSprites', bouncingSprites);
    // biome-ignore lint/suspicious/noConsole: the demo logs to the devtools on purpose
    console.log('FeatureSprites', mesh);

    // the .moreSprites and .lessSprites buttons are written by the markup of this very page
    const listening = new AbortController();
    document.querySelector('.moreSprites')!.addEventListener(
      'click',
      () => {
        bouncingSprites.createSprites(20, animId);
        renderSpriteCount(bouncingSprites.sprites.length);
      },
      {signal: listening.signal},
    );

    document.querySelector('.lessSprites')!.addEventListener(
      'click',
      () => {
        bouncingSprites.destroySprites(20);
        renderSpriteCount(bouncingSprites.sprites.length);
      },
      {signal: listening.signal},
    );

    demo.onDispose(() => {
      listening.abort();
      // the sprites leave the geometry and the material they were handed to the page; the store
      // takes its error listener and what it lent along
      mesh.dispose();
      material.dispose();
      geometry.dispose();
      animsMap.dispose();
      store.dispose();
    });
  });

  demo.start();
</script>
