---
import Layout from '~layouts/VanillaDemo.astro';
import {description, title} from './_swaying-grass.json';
---

<Layout title={title} description={description} fullscreenCanvas>
  <demo-ui></demo-ui>
</Layout>

<style>
  body {
    background: #0e2024;
    color: #d6efe6;
  }
</style>

<script>
  import {on, Priority} from '@spearwolf/eventize';
  import {createBloomOutputNodeBuilder, Display, OnDisplayRenderFrame, Stage2D, StageRenderer} from '@spearwolf/twopoint5d';
  import GUI from 'lil-gui';
  import {OrbitControls} from 'three/examples/jsm/controls/OrbitControls.js';
  import {Color, PerspectiveCamera, RenderPipeline} from 'three/webgpu';
  import {deferPreview} from '~demos/utils/demoPreview';
  import {getDemoUi} from '~demos/utils/demoUi';
  import {getFullscreenCanvas} from '~demos/utils/fullscreenCanvas';
  import {loadTextureCatalog} from '~demos/utils/loadTextureCatalog';
  import {MEADOW_BASES, MEADOW_PLACEMENTS, SwayingMeadow} from '~demos/swaying-grass/SwayingMeadow';

  // the preview screenshot waits for the meadow, not for the default delay
  const preview = deferPreview();

  // The display holds 60 frames per second by its resolution: it reads the GPU time of every frame
  // — the meadow, its shadows and the bloom chain alike — and draws an eighth fewer pixels per CSS
  // pixel where a frame costs too much, an eighth more where there is room, down to half the
  // pixel ratio. Above it, at most 2 device pixels per CSS pixel, the default
  const PIXEL_RATIOS = {'1': 1, '1.5': 1.5, '2': 2, device: 0} as const;
  const display = new Display(getFullscreenCanvas(), {adaptiveResolution: true});

  // a stage without a projection renders with the camera it is handed: a perspective camera that
  // orbits the meadow slowly, and that the mouse may take over
  const camera = new PerspectiveCamera(40, 1, 0.5, 1000);
  camera.position.set(0, 17, 44);
  const stage = new Stage2D();
  stage.camera = camera;
  // the colour of the foot of the hills, under the night where its image ends
  stage.scene.background = new Color('#0e2024');

  const controls = new OrbitControls(camera, display.renderer!.domElement);
  controls.target.set(0, 6, 0);
  controls.enableDamping = true;
  controls.autoRotate = true;
  controls.autoRotateSpeed = 0.35;
  controls.minDistance = 14;
  controls.maxDistance = 80;
  controls.maxPolarAngle = Math.PI / 2 - 0.05;

  display.onResize(({width, height}) => {
    camera.aspect = width / height;
    camera.updateProjectionMatrix();
  });

  // the glowcaps, the lumen lilies and the fireflies are tinted far above white: the glow recipe
  // of the sprites guide lets only them into the bloom
  const stageRenderer = new StageRenderer(display).setClearColor(new Color('#0e2024')).add(stage);
  const pipeline = new RenderPipeline(display.renderer!);
  const withGlow = createBloomOutputNodeBuilder({strength: 0.8, radius: 0.5, threshold: 1});
  stageRenderer.pipeline = pipeline;
  stageRenderer.buildOutputNode = withGlow;

  await display.start(async ({renderer}) => {
    const store = await loadTextureCatalog(renderer);
    // meadow.json is free-tex-packer's "JSON (hash)": the store reads it with TexturePackerJson,
    // picked by meta.app, unchanged
    const [atlas, texture] = await store.getAsync('meadowAtlas', ['atlas', 'texture']);
    const [back] = await store.getAsync('meadowBack', ['texture']);
    const [ground] = await store.getAsync('meadowGround', ['texture']);

    const meadow = new SwayingMeadow({atlas, texture}, {back, ground});
    stage.scene.add(meadow);

    // the meadow moves and the camera turns before the stage renderer draws the frame
    on(display, OnDisplayRenderFrame, Priority.High, ({deltaTime}) => {
      controls.update(deltaTime);
      meadow.update(deltaTime);
    });

    const gui = new GUI({title: 'swaying grass', container: getDemoUi()});
    const settings = {
      base: meadow.baseName,
      placement: meadow.placementName,
      shadows: meadow.shadows,
      orbit: controls.autoRotate,
    };
    gui
      .add(settings, 'base', Object.keys(MEADOW_BASES))
      .name('base')
      .onChange((name: keyof typeof MEADOW_BASES) => {
        meadow.baseName = name;
      });
    gui
      .add(settings, 'placement', Object.keys(MEADOW_PLACEMENTS))
      .name('placement')
      .onChange((name: keyof typeof MEADOW_PLACEMENTS) => {
        meadow.placementName = name;
      });
    const wind = gui.addFolder("wave({weight: 'top'})");
    wind.add(meadow.wind, 'waveAmplitude', 0, 3, 0.05);
    wind.add(meadow.wind, 'waveFrequency', 0.005, 0.2, 0.005);
    wind.add(meadow.wind, 'waveSpeed', -1.5, 1.5, 0.05);
    wind.add(meadow.wind, 'gusts');
    gui
      .add(settings, 'shadows')
      .name('ShadowPass')
      .onChange((on: boolean) => {
        meadow.shadows = on;
      });
    gui
      .add(settings, 'orbit')
      .name('orbit')
      .onChange((on: boolean) => {
        controls.autoRotate = on;
      });

    // what a frame costs the GPU: the pixel ratio sets how many pixels every pass shades, the
    // bloom adds a chain of passes at half that size and below
    const output = gui.addFolder('output');
    const outputSettings = {pixelRatio: '2' as keyof typeof PIXEL_RATIOS, bloom: true, drawingBuffer: ''};
    output
      .add(outputSettings, 'pixelRatio', Object.keys(PIXEL_RATIOS))
      .name('maxPixelRatio')
      .onChange((name: keyof typeof PIXEL_RATIOS) => {
        display.maxPixelRatio = PIXEL_RATIOS[name];
      });
    output
      .add(outputSettings, 'bloom')
      .name('bloom')
      .onChange((on: boolean) => {
        stageRenderer.buildOutputNode = on ? withGlow : undefined;
      });
    const drawingBuffer = output.add(outputSettings, 'drawingBuffer').name('drawing buffer').disable();
    display.onResize(({display: {canvas, pixelRatio}}) => {
      outputSettings.drawingBuffer = `${canvas.width} × ${canvas.height} @ ${pixelRatio}`;
      drawingBuffer.updateDisplay();
    });

    // what the controller reads and what it makes of it, read anew in every frame of the gui
    const adaptive = display.adaptiveResolution!;
    output.add(adaptive, 'enabled').name('adaptiveResolution');
    const adaptiveStatus = {
      get scale() {
        return adaptive.scale;
      },
      get method() {
        return adaptive.method ?? '…';
      },
      get gpuTime() {
        return adaptive.gpuTime == null ? '–' : `${adaptive.gpuTime.toFixed(2)} ms`;
      },
    };
    output.add(adaptiveStatus, 'scale').name('resolutionScale').disable().listen();
    output.add(adaptiveStatus, 'method').name('method').disable().listen();
    output.add(adaptiveStatus, 'gpuTime').name('GPU time').disable().listen();

    display.onDispose(() => {
      gui.destroy();
      controls.dispose();
      stageRenderer.dispose();
      withGlow.dispose();
      pipeline.dispose();
      meadow.dispose();
      store.dispose();
    });

    // biome-ignore lint/suspicious/noConsole: the demo logs to the devtools on purpose
    console.log('swaying meadow', meadow);

    preview.ready(display);
  });
</script>
