---
import TexturePreview from '~components/TexturePreview.astro';
import Layout from '~layouts/VanillaDemo.astro';
import {description, title} from './_textured-quads-from-texture-atlas.json';
---

<Layout title={title} description={description} fullscreenCanvas>
  <demo-ui>
    <TexturePreview />
  </demo-ui>
</Layout>

<style>
  body {
    background-color: #3f313f;
  }
</style>

<script>
  import type {TextureAtlas} from '@spearwolf/twopoint5d';
  import type {Texture} from 'three/webgpu';
  import {createTexturedQuads} from '~demos/instanced-quads/createTexturedQuads';
  import {setQuadTexCoords} from '~demos/instanced-quads/InstancedQuadsGeometry';
  import {PerspectiveOrbitDemo} from '~demos/utils/PerspectiveOrbitDemo';
  import {atlasFrame} from '~demos/utils/atlasFrame';
  import {startDemo} from '~demos/utils/demoInit';
  import {DemoParts} from '~demos/utils/demoParts';
  import {disposeMaterial} from '~demos/utils/disposeMaterial';
  import {getFullscreenCanvas} from '~demos/utils/fullscreenCanvas';
  import {loadTextureCatalog} from '~demos/utils/loadTextureCatalog';
  import {SeededRandom} from '~demos/utils/seededRandom';
  import {showTexturePreview} from '~demos/utils/showTexturePreview';

  const QUADS_SEED = 43;

  // next() stays below 1, so the index is inside a non-empty array
  function sample<T>(arr: T[], random: SeededRandom): T {
    return arr[Math.floor(random.next() * arr.length)]!;
  }

  // +================================================================================+
  //
  // create textured quads
  //
  // +================================================================================+

  function makeMesh(rows: number, columns: number, size: number, offset: number, atlas: TextureAtlas, texture: Texture) {
    const random = new SeededRandom(QUADS_SEED);
    const frames = atlas
      .frameNames(/numbers32/)
      // a pattern matches strings only, which the type of frameNames() does not say
      .filter((name): name is string => typeof name === 'string')
      .map((name) => atlasFrame(atlas, 'textured-quads-from-texture-atlas', name).coords);

    return createTexturedQuads({capacity: rows * columns, texture}, (vertexObjectPool) => {
      // the pool was built with a capacity of rows * columns and the two loops run exactly
      // that many times, so every createVO() finds room
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < columns; x++) {
          const quad = vertexObjectPool.createVO()!;

          quad.width = 1.0 + random.next() * (size - 1.0);
          quad.height = quad.width;

          quad.setInstancePosition([
            x * size * offset - ((columns - 1) * size * offset) / 2,
            y * size * offset - ((rows - 1) * size * offset) / 2,
            0,
          ]);

          const texCoords = sample(frames, random);
          setQuadTexCoords(quad, texCoords);
        }
      }
    });
  }

  // +================================================================================+
  //
  // start demo
  //
  // +================================================================================+

  const demo = new PerspectiveOrbitDemo(getFullscreenCanvas());

  await startDemo(demo, 'textured-quads-from-texture-atlas', async ({renderer}) => {
    const store = await loadTextureCatalog(renderer);
    const [atlas, texture] = await store.getAsync('labWallsAtlas', ['atlas', 'texture']).catch((error: unknown) => {
      // a loader that fails disposes the store it built
      store.dispose();
      throw error;
    });
    // a dispose() while the assets loaded has gone out already: nothing is built
    if (demo.isDisposed) {
      store.dispose();
      return;
    }

    const parts = new DemoParts(demo);
    parts.keep(store);

    // biome-ignore lint/suspicious/noConsole: the demo logs to the devtools on purpose
    console.log('loaded texture-atlas', {atlas, texture});

    // the <TexturePreview> in the markup of this very page writes #texture-preview
    showTexturePreview(texture);

    const mesh = makeMesh(16, 32, 3.5, 1, atlas, texture);
    // createTexturedQuads() built the geometry and the one material, the store lent the texture
    parts.onDispose(() => {
      mesh.geometry?.dispose();
      disposeMaterial(mesh.material);
    });

    // biome-ignore lint/suspicious/noConsole: the demo logs to the devtools on purpose
    console.log('TexturedQuadsMesh', mesh);

    demo.scene.add(mesh);
  });
</script>
