---
import Layout from '~layouts/VanillaDemo.astro';
import {description, title} from './_textured-quads-from-texture-atlas.json';
---

<Layout title={title} description={description}>
  <canvas id="canvas-container" resize-to="window"></canvas>

  <div id="texture-preview" class="texture-preview"></div>
</Layout>

<style>
  body {
    height: 100vh;
    overflow-y: hidden;
    background-color: #3f313f;
  }
  .texture-preview {
    background-color: rgba(86, 101, 115, 80%);
    border: 5px solid #324168;
    border-radius: 5px;
    width: 150px;
    height: 150px;
    position: fixed;
    bottom: 20px;
    right: 20px;
    box-shadow: 5px 5px 10px rgba(0 0 0 / 50%);
    overflow: hidden;
  }
  .texture-preview :global(img),
  .texture-preview :global(canvas) {
    max-width: 100%;
  }
</style>

<script>
  import type {TextureAtlas} from '@spearwolf/twopoint5d';
  import {TextureStore} from '@spearwolf/twopoint5d';
  import type {Texture} from 'three/webgpu';
  import {createTexturedQuads} from '~demos/instanced-quads/createTexturedQuads';
  import {setQuadTexCoords} from '~demos/instanced-quads/InstancedQuadsGeometry';
  import {PerspectiveOrbitDemo} from '~demos/utils/PerspectiveOrbitDemo';
  import assetsUrl from '~demos/utils/assetsUrl';

  // Math.random() stays below 1, so the index is inside a non-empty array
  function sample<T>(arr: T[]): T {
    return arr[Math.floor(Math.random() * arr.length)]!;
  }

  // +================================================================================+
  //
  // create textured quads
  //
  // +================================================================================+

  function makeMesh(rows: number, columns: number, size: number, offset: number, atlas: TextureAtlas, texture: Texture) {
    // the names come out of frameNames() of this very atlas, so frame() finds each of them
    const frames = atlas.frameNames(/numbers32/).map((name) => atlas.frame(name)!.coords);

    return createTexturedQuads({capacity: rows * columns, texture}, (vertexObjectPool) => {
      // the pool was built with a capacity of rows * columns and the two loops run exactly
      // that many times, so every createVO() finds room
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < columns; x++) {
          const quad = vertexObjectPool.createVO()!;

          quad.width = 1.0 + Math.random() * (size - 1.0);
          quad.height = quad.width;

          quad.setInstancePosition([
            x * size * offset - ((columns - 1) * size * offset) / 2,
            y * size * offset - ((rows - 1) * size * offset) / 2,
            0,
          ]);

          const texCoords = sample(frames);
          setQuadTexCoords(quad, texCoords);
        }
      }
    });
  }

  // +================================================================================+
  //
  // start demo
  //
  // +================================================================================+

  // the <canvas id="canvas-container"> is written by the markup of this very page
  const demo = new PerspectiveOrbitDemo(document.getElementById('canvas-container')!);

  await demo.start(async ({renderer}) => {
    const store = new TextureStore(renderer);
    // the catalog of the lookbook, public/assets/textures.json, names the image, tile set and texture classes of each item
    await store.loadAsync(assetsUrl('textures.json'));
    const [atlas, texture] = await store.getAsync('labWallsAtlas', ['atlas', 'texture']);

    // eslint-disable-next-line no-console
    console.log('loaded texture-atlas', {atlas, texture});

    // a copy: an <img> in the layout answers width and height as its CSS sizes it, and three.js
    // reads the size of the texture from there
    if (texture.image instanceof HTMLImageElement) {
      // the <div id="texture-preview"> is written by the markup of this very page
      document.getElementById('texture-preview')!.appendChild(texture.image.cloneNode());
    }

    const mesh = makeMesh(16, 32, 3.5, 1, atlas, texture);

    // eslint-disable-next-line no-console
    console.log('TexturedQuadsMesh', mesh);

    demo.scene.add(mesh);
  });
</script>
