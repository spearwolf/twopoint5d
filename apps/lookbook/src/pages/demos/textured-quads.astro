---
import TexturePreview from '~components/TexturePreview.astro';
import Layout from '~layouts/VanillaDemo.astro';
import {description, title} from './_textured-quads.json';
---

<Layout title={title} description={description} fullscreenCanvas>
  <demo-ui>
    <TexturePreview size={256} />
  </demo-ui>
</Layout>

<style>
  body {
    background: radial-gradient(circle, rgb(195, 130, 74) 0%, rgb(95, 26, 26) 100%);
  }
</style>

<script>
  import type {TextureCoords} from '@spearwolf/twopoint5d';
  import {colorFromTextureByTexCoords, vertexByInstancePosition, VertexObjects} from '@spearwolf/twopoint5d';
  import {attribute, vec3} from 'three/tsl';
  import type {Texture} from 'three/webgpu';
  import {AgXToneMapping, NodeMaterial} from 'three/webgpu';
  import {InstancedQuadsGeometry, setQuadTexCoords} from '~demos/instanced-quads/InstancedQuadsGeometry';
  import {PerspectiveOrbitDemo} from '~demos/utils/PerspectiveOrbitDemo';
  import {getFullscreenCanvas} from '~demos/utils/fullscreenCanvas';
  import {loadTextureCatalog} from '~demos/utils/loadTextureCatalog';
  import {showTexturePreview} from '~demos/utils/showTexturePreview';

  // +================================================================================+
  //
  // create instanced geometry and mesh
  //
  // +================================================================================+

  function createMesh(rows: number, columns: number, size: number, offset: number, texCoords: TextureCoords, texture: Texture) {
    const geometry = new InstancedQuadsGeometry(rows * columns);

    // the geometry was built with a capacity, so it has its base pool, and the first
    // createVO() on that pool finds room
    geometry.basePool!.createVO()!.make();

    // the instanced pool holds rows * columns quads and the two loops run exactly that
    // many times, so every createVO() finds room
    for (let y = 0; y < rows; y++) {
      for (let x = 0; x < columns; x++) {
        const quad = geometry.instancedPool.createVO()!;

        quad.width = 1.0 + Math.random() * (size - 1.0);
        quad.height = quad.width;

        quad.setInstancePosition([
          x * size * offset - ((columns - 1) * size * offset) / 2,
          y * size * offset - ((rows - 1) * size * offset) / 2,
          0,
        ]);

        setQuadTexCoords(quad, texCoords);
      }
    }

    const mesh = new VertexObjects(geometry, createMaterial(texture));

    mesh.name = 'InstancedQuadsMesh';

    mesh.update();

    return mesh;
  }

  // +================================================================================+
  //
  // create material
  //
  // +================================================================================+

  function createMaterial(texture: Texture) {
    const material = new NodeMaterial();

    material.positionNode = vertexByInstancePosition({scale: vec3(attribute<'vec2'>('quadSize'), 1.0)});

    material.colorNode = colorFromTextureByTexCoords(texture, {flipDiagonal: attribute<'float'>('texFlipDiagonal')});

    return material;
  }

  // +================================================================================+
  //
  // start demo
  //
  // +================================================================================+

  const demo = new PerspectiveOrbitDemo(getFullscreenCanvas());

  await demo.start(async ({renderer}) => {
    renderer.toneMapping = AgXToneMapping;
    renderer.toneMappingExposure = 1.1;

    const store = await loadTextureCatalog(renderer);
    const [texCoords, texture] = await store.getAsync('ballPatternRot', ['imageCoords', 'texture']);

    // biome-ignore lint/suspicious/noConsole: the demo logs to the devtools on purpose
    console.log('loaded texture-image', {texCoords, texture});

    // the <TexturePreview> in the markup of this very page writes #texture-preview
    showTexturePreview(texture);

    demo.scene.add(createMesh(16, 32, 3.7, 1, texCoords, texture));
  });

  // biome-ignore lint/suspicious/noConsole: the demo logs to the devtools on purpose
  console.log('TexturedQuadsMesh', demo.scene.children[0]);
</script>
