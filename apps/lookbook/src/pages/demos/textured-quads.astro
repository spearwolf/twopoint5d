---
import Layout from '~layouts/VanillaDemo.astro';
import {description, title} from './_textured-quads.json';
---

<Layout title={title} description={description}>
  <canvas id="canvas-container" resize-to="window"></canvas>

  <div id="texture-preview" class="texture-preview"></div>
</Layout>

<style>
  body {
    height: 100vh;
    overflow-y: hidden;
    background: radial-gradient(circle, rgb(195, 130, 74) 0%, rgb(95, 26, 26) 100%);
  }

  .texture-preview {
    background-color: rgba(100, 100, 100, 0.8);
    border: 1px solid #000;
    border-radius: 5px;
    width: 256px;
    height: 256px;
    position: fixed;
    bottom: 20px;
    right: 20px;
    box-shadow:
      0 0 0 2px #b1b1a2,
      5px 5px 10px rgba(31, 29, 18, 0.5);
    overflow: hidden;
  }
  .texture-preview :global(img),
  .texture-preview :global(canvas) {
    max-width: 100%;
  }
</style>

<script>
  import type {TextureCoords} from '@spearwolf/twopoint5d';
  import {colorFromTextureByTexCoords, TextureStore, vertexByInstancePosition, VertexObjects} from '@spearwolf/twopoint5d';
  import {attribute, vec3} from 'three/tsl';
  import type {Texture} from 'three/webgpu';
  import {AgXToneMapping, NodeMaterial} from 'three/webgpu';
  import {InstancedQuadsGeometry, setQuadTexCoords} from '~demos/instanced-quads/InstancedQuadsGeometry';
  import {PerspectiveOrbitDemo} from '~demos/utils/PerspectiveOrbitDemo';
  import assetsUrl from '~demos/utils/assetsUrl';

  // +================================================================================+
  //
  // create instanced geometry and mesh
  //
  // +================================================================================+

  async function createMesh(
    rows: number,
    columns: number,
    size: number,
    offset: number,
    texCoords: TextureCoords,
    texture: Texture,
  ) {
    const geometry = new InstancedQuadsGeometry(rows * columns);

    // the geometry was built with a capacity, so it has its base pool, and the first
    // createVO() on that pool finds room
    geometry.basePool!.createVO()!.make();

    // the instanced pool holds rows * columns quads and the two loops run exactly that
    // many times, so every createVO() finds room
    for (let y = 0; y < rows; y++) {
      for (let x = 0; x < columns; x++) {
        const quad = geometry.instancedPool.createVO()!;

        quad.width = 1.0 + Math.random() * (size - 1.0);
        quad.height = quad.width;

        quad.setInstancePosition([
          x * size * offset - ((columns - 1) * size * offset) / 2,
          y * size * offset - ((rows - 1) * size * offset) / 2,
          0,
        ]);

        setQuadTexCoords(quad, texCoords);
      }
    }

    const mesh = new VertexObjects(geometry, await createMaterial(texture));

    mesh.name = 'InstancedQuadsMesh';

    mesh.update();

    return mesh;
  }

  // +================================================================================+
  //
  // create material
  //
  // +================================================================================+

  async function createMaterial(texture: Texture) {
    const material = new NodeMaterial();

    material.positionNode = vertexByInstancePosition({scale: vec3(attribute<'vec2'>('quadSize'), 1.0)});

    material.colorNode = colorFromTextureByTexCoords(texture, {flipDiagonal: attribute<'float'>('texFlipDiagonal')});

    return material;
  }

  // +================================================================================+
  //
  // start demo
  //
  // +================================================================================+

  // the <canvas id="canvas-container"> is written by the markup of this very page
  const demo = new PerspectiveOrbitDemo(document.getElementById('canvas-container')!);

  await demo.start(async ({renderer}) => {
    renderer.toneMapping = AgXToneMapping;
    renderer.toneMappingExposure = 1.1;

    const store = new TextureStore(renderer);
    // the catalog of the lookbook, public/assets/textures.json, names the image, tile set and texture classes of each item
    await store.loadAsync(assetsUrl('textures.json'));
    const [texCoords, texture] = await store.getAsync('ballPatternRot', ['imageCoords', 'texture']);

    // eslint-disable-next-line no-console
    console.log('loaded texture-image', {texCoords, texture});

    // a copy: an <img> in the layout answers width and height as its CSS sizes it, and three.js
    // reads the size of the texture from there
    if (texture.image instanceof HTMLImageElement) {
      // the <div id="texture-preview"> is written by the markup of this very page
      document.getElementById('texture-preview')!.appendChild(texture.image.cloneNode());
    }

    demo.scene.add(await createMesh(16, 32, 3.7, 1, texCoords, texture));
  });

  // eslint-disable-next-line no-console
  console.log('TexturedQuadsMesh', demo.scene.children[0]);
</script>
