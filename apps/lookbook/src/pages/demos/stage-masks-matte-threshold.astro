---
import Layout from '~layouts/VanillaDemo.astro';
import {description, title} from './_stage-masks-matte-threshold.json';
---

<Layout title={title} description={description} fullscreenCanvas>
  <demo-ui></demo-ui>
  <div id="scope-caption" class="scope-caption">
    mask stage · raw coverage<br /><span>cyan: switched (coverage &lt; progress)</span>
  </div>
</Layout>

<style>
  body {
    background: #000;
  }

  .scope-caption {
    position: fixed;
    z-index: 10;
    display: none;
    font:
      11px / 1.35 ui-monospace,
      'SFMono-Regular',
      Menlo,
      monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: right;
    color: #7ff6ea;
    text-shadow: 0 0 6px rgba(0, 0, 0, 0.9);
    pointer-events: none;
  }

  .scope-caption span {
    color: #a9c7c4;
    text-transform: none;
    letter-spacing: 0.02em;
  }
</style>

<script>
  import {
    Display,
    matte,
    StageDirector,
    type StageDirectorShape,
    StageMask,
    type StageTransitionEasing,
    type StageTransitionEffect,
  } from '@spearwolf/twopoint5d';
  import GUI from 'lil-gui';
  import {Color} from 'three/webgpu';
  import {SONAR_KINDS, SonarField, SonarHud, type SonarKind, SonarMaskStage} from '~demos/stage-masks/Sonar';
  import {TransitionCycler} from '~demos/stage-masks/TransitionCycler';
  import {loadTrenchAssets, ThingView, TrenchView} from '~demos/stage-masks/Trench';
  import {catchPrecompile, onDemoInit} from '~demos/utils/demoInit';
  import {deferPreview} from '~demos/utils/demoPreview';
  import {getDemoUi} from '~demos/utils/demoUi';
  import {getFullscreenCanvas} from '~demos/utils/fullscreenCanvas';

  // how long a scene holds before the sonar sweeps it away, while "cycle" is on, in seconds
  const HOLD = 2.8;
  // how long the card of the lookbook waits for the eyes of the thing to open, in ms
  const PREVIEW_SETTLE = 2600;
  // the softness values the UI offers: softness is an option of matte(), read once when the effect
  // is made, so each value is an effect of its own — and a shader of its own, compiled ahead below
  const SOFTNESS = [0, 0.02, 0.05, 0.1, 0.2, 0.35] as const;

  const isPreview = new URLSearchParams(location.search).get('preview') === '1';
  const preview = deferPreview();
  const canvas = getFullscreenCanvas();
  canvas.style.touchAction = 'none';
  const caption = document.getElementById('scope-caption') as HTMLElement;
  const display = new Display(canvas);
  const director = new StageDirector(display).setClearColor(new Color('#000000'), 1);
  // here, before the init: the director goes even when the display is disposed before the init
  // or while it loads; it only lets go of what it shows, which the init frees
  display.onDispose(() => director.dispose());

  const settings = {
    softness: 0.05 as number,
    kind: 'sonar sweep' as SonarKind,
    duration: 4,
    easing: 'linear' as StageTransitionEasing,
    cycle: true,
    scope: true,
    scrub: false,
    progress: 0.45,
  };

  onDemoInit(display, 'stage-masks-matte-threshold', async ({renderer}) => {
    const assets = await loadTrenchAssets(renderer);
    if (display.isDisposed) {
      assets.store.dispose();
      return;
    }

    const survey = new TrenchView('survey', assets.survey, assets.layout);
    const thing = new ThingView(assets);

    // the sonar: one field, read by the mask stage, the display above the slot and the scope. The
    // mask stage is never in the stack: matte() names its mask, the director draws it only while a
    // transition runs
    const field = new SonarField(assets.layout.NOSE);
    const sonar = new SonarMaskStage(field);
    const ping = new StageMask(sonar.stage, {source: 'luminance'});
    const hud = new SonarHud(canvas);
    hud.bind(field, ping);

    // 'threshold' mode: the gray of the field is when a pixel switches. One effect per softness,
    // made once and reused
    const effects = new Map<number, StageTransitionEffect>();
    for (const softness of SOFTNESS) effects.set(softness, matte({mask: ping, mode: 'threshold', softness}));

    director.setStack([survey.stage, hud.stage]);

    let runningSoftness: number = settings.softness;

    display.onRenderFrame(({deltaTime}) => field.update(deltaTime));

    // K picks the next mask kind
    const nextKind = () => {
      settings.kind = SONAR_KINDS[(SONAR_KINDS.indexOf(settings.kind) + 1) % SONAR_KINDS.length]!;
      field.kind = settings.kind;
    };

    // the slot between the survey and the thing: played, scrubbed by hand or cycled, with Space,
    // Enter and S
    const cycler = new TransitionCycler({
      display,
      director,
      stages: [survey.stage, thing.stage],
      names: ['survey', 'the thing'],
      settings,
      hold: HOLD,
      onBegin: (_from, to) => {
        if (to === thing.stage) thing.wake();
        runningSoftness = settings.softness;
        hud.softness.value = runningSoftness;
        hud.running = true;
      },
      onEnd: () => {
        hud.running = false;
      },
      effect: () => effects.get(runningSoftness)!,
      progress: () => ping.progress,
      progressName: 'ping.progress',
      keys: {KeyK: nextKind},
    });

    const gui = new GUI({container: getDemoUi(), title: 'Sonar'});
    // a new softness is a new effect: a run by hand starts again with it, at the same progress, in
    // the same direction; a run by the clock keeps its own and the next one takes the new value
    gui
      .add(settings, 'softness', [...SOFTNESS])
      .name('matte softness')
      .onChange(() => cycler.restart());
    gui
      .add(settings, 'kind', [...SONAR_KINDS])
      .name('mask kind (k)')
      .onChange(() => {
        field.kind = settings.kind;
      })
      .listen();
    gui
      .add(settings, 'scope')
      .name('scope: the raw mask')
      .onChange(() => {
        hud.scopeVisible = settings.scope;
      });
    cycler.addControls(gui, {min: 0.5, max: 10});
    // the softness of the run on the screen, written only when it changes
    const readout = {softness: '—'};
    gui.add(readout, 'softness').name('softness of the run').disable().listen();
    let shownSoftness = -1;

    // the caption of the scope follows where the HUD put it
    let captionShown = false;
    let captionBottom = -1;
    let captionRight = -1;
    const onFrame = () => {
      const softness = cycler.running ? runningSoftness : -1;
      if (softness !== shownSoftness) {
        shownSoftness = softness;
        readout.softness = softness === -1 ? '—' : softness.toFixed(2);
      }
      const show = settings.scope && hud.scope.width > 0;
      if (show !== captionShown) {
        captionShown = show;
        caption.style.display = show ? 'block' : 'none';
      }
      const bottom = Math.round(hud.scope.bottom + hud.scope.height + 6);
      if (bottom !== captionBottom || hud.scope.right !== captionRight) {
        captionBottom = bottom;
        captionRight = hud.scope.right;
        caption.style.bottom = `${bottom}px`;
        caption.style.right = `${captionRight}px`;
      }
    };
    display.onRenderFrame(onFrame);

    // every shape the slot takes — a scene alone, and the sonar between two at each softness — with
    // both scenes, the display and the mask stage drawn once ahead. One mask with one source and
    // invert, so one shader per softness; the mask kind is a uniform and needs none
    const shapes: StageDirectorShape[] = [['layer', 'layer']];
    for (const effect of effects.values()) shapes.push([effect, 'layer']);
    const precompiled = catchPrecompile(
      'stage-masks-matte-threshold',
      director.precompile(renderer, shapes, {layers: [survey.stage, thing.stage, hud.stage, sonar.stage]}),
    );

    // the card of the lookbook: the pulse rings held where half the trench has switched — the rings
    // cut the thing into bands wherever the pings are, so the card always shows it
    if (isPreview) {
      settings.kind = 'pulse rings';
      field.kind = settings.kind;
      cycler.holdAt(0.5);
    }

    let previewTimeout: ReturnType<typeof setTimeout> | undefined;

    display.onDispose(() => {
      clearTimeout(previewTimeout);
      cycler.dispose();
      gui.destroy();
      ping.dispose();
      sonar.dispose();
      hud.dispose();
      survey.dispose();
      thing.dispose();
      assets.store.dispose();
    });

    await precompiled;
    if (display.isDisposed) return;
    // precompile() may have drawn and updated the thing off screen: its eyes start shut from here
    thing.wake();
    previewTimeout = setTimeout(() => preview.ready(display), PREVIEW_SETTLE);
  });

  await display.start();

  Object.assign(window, {display, director});
</script>
