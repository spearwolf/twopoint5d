---
import TexturePreview from '~components/TexturePreview.astro';
import Layout from '~layouts/VanillaDemo.astro';
import {description, title} from './_textured-quads-from-tileset.json';
---

<Layout title={title} description={description} fullscreenCanvas>
  <TexturePreview title="tileset image" />
</Layout>

<style>
  body {
    background: radial-gradient(circle, rgba(109 80 87) 0%, rgba(21 2 41) 100%);
  }
</style>

<script>
  import type {TileSet} from '@spearwolf/twopoint5d';
  import {float} from 'three/tsl';
  import type {Texture} from 'three/webgpu';
  import {DoubleSide, MeshBasicNodeMaterial, NeutralToneMapping} from 'three/webgpu';
  import {createTexturedQuads} from '~demos/instanced-quads/createTexturedQuads';
  import {setQuadTexCoords} from '~demos/instanced-quads/InstancedQuadsGeometry';
  import {PerspectiveOrbitDemo} from '~demos/utils/PerspectiveOrbitDemo';
  import {getFullscreenCanvas} from '~demos/utils/fullscreenCanvas';
  import {loadTextureCatalog} from '~demos/utils/loadTextureCatalog';
  import {showTexturePreview} from '~demos/utils/showTexturePreview';

  // +================================================================================+
  //
  // create textured quads
  //
  // +================================================================================+

  function makeMesh(rows: number, columns: number, size: number, offset: number, tileset: TileSet, texture: Texture) {
    const capacity = rows * columns;

    const material = new MeshBasicNodeMaterial({
      transparent: true,
      side: DoubleSide,
      alphaTestNode: float(0.05),
    });

    return createTexturedQuads({capacity, texture, material}, (vertexObjectPool) => {
      // the pool was built with a capacity of rows * columns and the two loops run exactly
      // that many times, so every createVO() finds room
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < columns; x++) {
          const quad = vertexObjectPool.createVO()!;

          quad.width = 1.0 + Math.random() * (size - 1.0);
          quad.height = quad.width;

          quad.setInstancePosition([
            x * size * offset - ((columns - 1) * size * offset) / 2,
            y * size * offset - ((rows - 1) * size * offset) / 2,
            0,
          ]);

          // the tileset is loaded before makeMesh() runs, so its atlas has frames to draw from
          const texCoords = tileset.atlas.randomFrame()!.coords;

          setQuadTexCoords(quad, texCoords);
        }
      }
    });
  }

  // +================================================================================+
  //
  // start demo
  //
  // +================================================================================+

  const demo = new PerspectiveOrbitDemo(getFullscreenCanvas());

  await demo.start(async ({renderer}) => {
    renderer.toneMapping = NeutralToneMapping;

    const store = await loadTextureCatalog(renderer);
    const [tileSet, texture] = await store.getAsync('glaskugelnTiles', ['tileSet', 'texture']);

    // eslint-disable-next-line no-console
    console.log('loaded tileset', {tileSet, texture});

    // the <TexturePreview> in the markup of this very page writes #texture-preview
    showTexturePreview(texture);

    demo.scene.add(makeMesh(16, 32, 3.5, 1, tileSet, texture));
  });

  // eslint-disable-next-line no-console
  console.log('TexturedQuadsMesh', demo.scene.children[0]);
</script>
