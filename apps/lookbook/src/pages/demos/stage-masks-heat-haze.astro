---
import Layout from '~layouts/VanillaDemo.astro';
import {description, title} from './_stage-masks-heat-haze.json';
---

<Layout title={title} description={description} fullscreenCanvas>
  <demo-ui></demo-ui>
</Layout>

<style>
  body {
    background: #000;
  }
</style>

<script>
  import {Display, StageDirector, type StageTransitionEasing} from '@spearwolf/twopoint5d';
  import GUI from 'lil-gui';
  import {Color} from 'three/webgpu';
  import {
    CrematoriumView,
    disposeCrematoriumAssets,
    HeatColumn,
    loadCrematoriumAssets,
  } from '~demos/stage-masks/CrematoriumWindow';
  import {heatHaze} from '~demos/stage-masks/heatHaze';
  import {TransitionCycler} from '~demos/stage-masks/TransitionCycler';
  import {catchPrecompile, onDemoInit} from '~demos/utils/demoInit';
  import {deferPreview} from '~demos/utils/demoPreview';
  import {getDemoUi} from '~demos/utils/demoUi';
  import {getFullscreenCanvas} from '~demos/utils/fullscreenCanvas';

  // how long a picture holds before the heat rises again, while "cycle" is on, in seconds
  const HOLD = 3;
  // how long the card of the lookbook waits for the plumes to climb, in ms
  const PREVIEW_SETTLE = 1800;

  const isPreview = new URLSearchParams(location.search).get('preview') === '1';
  const preview = deferPreview();
  const canvas = getFullscreenCanvas();
  const display = new Display(canvas);
  const director = new StageDirector(display).setClearColor(new Color('#000000'), 1);

  const settings = {
    strength: 1,
    duration: 5,
    easing: 'ease-in-out' as StageTransitionEasing,
    cycle: true,
    scrub: false,
    progress: 0.5,
  };

  onDemoInit(display, 'stage-masks-heat-haze', async ({renderer}) => {
    const assets = await loadCrematoriumAssets(renderer);
    if (display.isDisposed) {
      disposeCrematoriumAssets(assets);
      return;
    }

    const snow = new CrematoriumView('snow', assets);
    const ash = new CrematoriumView('ash', assets);

    // the heat: a living mask stage, never in the stack. The effect names its mask, so the director
    // draws the column only while a transition runs. Made once and reused, as every effect
    const heat = new HeatColumn(assets.layout);
    const haze = heatHaze({mask: heat.mask, strength: settings.strength});

    director.setStack([snow.stage]);

    // the slot between snow and ash: played, scrubbed by hand or cycled, with Space, Enter and S
    const cycler = new TransitionCycler({
      display,
      director,
      stages: [snow.stage, ash.stage],
      names: ['snow', 'ash'],
      settings,
      hold: HOLD,
      effect: () => haze,
      progress: () => heat.mask.progress,
      progressName: 'heat.progress',
    });

    // how far the heat bends the picture during a run, in thousandths, written only when it changes
    const readout = {bend: '0.000'};
    let shownBend = 0;
    display.onRenderFrame(() => {
      const p = heat.mask.progress;
      const bend = cycler.running && p > 0 && p < 1 ? Math.round(Math.sin(p * Math.PI) * haze.strength.value * 1000) : 0;
      if (bend !== shownBend) {
        shownBend = bend;
        readout.bend = (bend / 1000).toFixed(3);
      }
    });

    const gui = new GUI({container: getDemoUi(), title: 'Crematorium Window'});
    // the strength is a uniform of the effect: it changes mid-transition and needs no new shader
    gui
      .add(settings, 'strength', 0, 3, 0.01)
      .name('haze strength')
      .onChange(() => {
        haze.strength.value = settings.strength;
      });
    cycler.addControls(gui, {min: 1, max: 12});
    gui.add(readout, 'bend').name('bend (strength·sin πp)').disable().listen();

    // every shape the slot takes: a picture alone, and the heat between the two. The strength is a
    // uniform, so one shader serves every value of the slider; both pictures and the heat column are
    // drawn once ahead
    const precompiled = catchPrecompile(
      'stage-masks-heat-haze',
      director.precompile(renderer, [['layer'], [haze]], {layers: [snow.stage, ash.stage, heat.stage]}),
    );

    // the card of the lookbook: held half way, the ash showing through the heat over the vent
    if (isPreview) cycler.holdAt(0.42);

    let previewTimeout: ReturnType<typeof setTimeout> | undefined;

    display.onDispose(() => {
      clearTimeout(previewTimeout);
      cycler.dispose();
      gui.destroy();
      // the director lets go of the layers and of the mask stage first, then each goes
      director.dispose();
      heat.dispose();
      snow.dispose();
      ash.dispose();
      disposeCrematoriumAssets(assets);
    });

    await precompiled;
    if (display.isDisposed) return;
    previewTimeout = setTimeout(() => preview.ready(display), PREVIEW_SETTLE);
  });

  await display.start();

  Object.assign(window, {display, director});
</script>
