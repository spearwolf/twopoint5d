---
import Layout from '~layouts/VanillaDemo.astro';
import {description, title} from './_map2d-tile-sprites.json';
---

<Layout title={title} description={description} fullscreenCanvas />

<style>
  body {
    background-color: #458497;
    background-image: linear-gradient(to right bottom, #458497 0, #2e4564 52%, #9b1a61);
    color: #eee;
  }
</style>

<script>
  import {run} from '~demos/map2d/map2d-tile-sprites';
  import {PerspectiveOrbitDemo} from '~demos/utils/PerspectiveOrbitDemo';
  import {getFullscreenCanvas} from '~demos/utils/fullscreenCanvas';

  run(new PerspectiveOrbitDemo(getFullscreenCanvas(), {antialias: false}));
</script>
