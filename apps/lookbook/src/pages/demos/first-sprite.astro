---
import Layout from '~layouts/VanillaDemo.astro';
import {description, title} from './_first-sprite.json';
---

<Layout title={title} description={description} fullscreenCanvas />

<style>
  body {
    background: radial-gradient(circle, rgb(64, 82, 122) 0%, rgb(20, 22, 48) 100%);
  }
</style>

<script>
  import {Display, FeatureSprites, TexturedSpriteKind, TextureStore} from '@spearwolf/twopoint5d';
  import {PerspectiveCamera, Scene} from 'three/webgpu';
  import assetsUrl from '~demos/utils/assetsUrl';
  import {onDemoInit} from '~demos/utils/demoInit';
  import {getFullscreenCanvas} from '~demos/utils/fullscreenCanvas';
  import {deferPreview} from '~demos/utils/demoPreview';

  // the vertical field of view of the camera, in degrees
  const FIELD_OF_VIEW = 60;
  // one world unit per pixel of the frame: from this far away the camera sees about 460
  // units across the shorter side of the window, and the frame of 256 × 296 pixels stands
  // in it with room to spare
  const CAMERA_DISTANCE = 400;

  // the preview screenshot waits for the sprite, not for the default delay
  const preview = deferPreview();

  // the display owns the renderer, drives the frame loop and follows the window's size
  const display = new Display(getFullscreenCanvas());

  const scene = new Scene();
  const camera = new PerspectiveCamera(FIELD_OF_VIEW);

  display.onResize(({width, height}) => {
    camera.aspect = width / height;
    // the field of view is vertical: a window taller than wide moves the camera back, so
    // the sprite fits across as well
    camera.position.z = CAMERA_DISTANCE / Math.min(1, camera.aspect);
    camera.updateProjectionMatrix();
  });

  // the display does not wait for the promise of an async init: onDemoInit() catches a failed
  // load and shows it under the name of the demo, in the console and over the canvas
  onDemoInit(display, 'first-sprite', async ({renderer}) => {
    // the catalog of the lookbook names each texture, the image behind it and its frames
    const store = new TextureStore(renderer);
    const [atlas, texture] = await store
      .loadAsync(assetsUrl('textures.json'))
      .then(() => store.getAsync('splotchs', ['atlas', 'texture']))
      .catch((error: unknown) => {
        // a loader that fails disposes the store it built
        store.dispose();
        throw error;
      });

    // a dispose() while the catalog and the texture loaded has gone out already, and an
    // onDispose() from here on would never hear it: the store goes, and nothing is built
    if (display.isDisposed) {
      store.dispose();
      return;
    }

    // splotchs-256x.json names the frame splotch0, 256 × 296 pixels, so frame() finds it
    const frame = atlas.frame('splotch0')!;

    // a mesh with room for one sprite, drawn with the texture of the atlas
    const sprites = new FeatureSprites(TexturedSpriteKind, {capacity: 1, textures: {colorMap: texture}});

    // the mesh has room for one sprite, and this is the first to take it
    const sprite = sprites.createSprite()!;
    sprite.setSize(frame.coords.width, frame.coords.height);
    sprite.setFrame(frame);

    // upload what the sprite wrote into the buffers of the mesh
    sprites.update();
    scene.add(sprites);

    // the next frame draws the sprite: the moment for the preview image
    preview.ready(display);

    display.onDispose(() => {
      // the mesh releases the material it built around the texture, the store the texture
      sprites.dispose();
      store.dispose();
    });
  });

  display.onRenderFrame(({renderer}) => {
    renderer.render(scene, camera);
  });

  await display.start();
</script>
