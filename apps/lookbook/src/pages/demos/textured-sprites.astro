---
import Layout from '~layouts/VanillaDemo.astro';
import {description, title} from './_textured-sprites.json';
---

<Layout title={title} description={description} fullscreenCanvas>
  <demo-ui>
    <section
      class="fixed top-[calc(var(--demo-nav-bar-height)+1rem)] right-4 flex flex-wrap gap-1 items-center content-center justify-center"
    >
      <div class="actionBtn render-as-billboards select-none" data-render-as-billboards="true">render as billboards</div>
    </section>
  </demo-ui>
</Layout>

<style>
  body {
    background: radial-gradient(circle, rgb(175 82 82) 0%, rgb(90 148 191) 100%);
    color: #eee;
    font-family: sans-serif;
    font-size: 16px;
    line-height: 2;
  }
</style>

<script>
  import {BillboardPlacement, FeatureSprites, FlatPlacement, TexturedSpriteKind} from '@spearwolf/twopoint5d';
  import {LessEqualDepth} from 'three/webgpu';
  import {BouncingSprites} from '~demos/textured-sprites/BouncingSprites';
  import {PerspectiveOrbitDemo} from '~demos/utils/PerspectiveOrbitDemo';
  import {onDemoInit} from '~demos/utils/demoInit';
  import {getFullscreenCanvas} from '~demos/utils/fullscreenCanvas';
  import {loadTextureCatalog} from '~demos/utils/loadTextureCatalog';

  const RENDER_AS_BILLBOARDS = 'render-as-billboards';

  const demo = new PerspectiveOrbitDemo(getFullscreenCanvas());

  onDemoInit(demo, 'textured-sprites', async ({renderer}) => {
    const store = await loadTextureCatalog(renderer);
    const [tileSet, texture] = await store.getAsync('skinballTiles', ['tileSet', 'texture']).catch((error: unknown) => {
      // a loader that fails disposes the store it built
      store.dispose();
      throw error;
    });
    // a dispose() while the assets loaded has gone out already: nothing is built
    if (demo.isDisposed) {
      store.dispose();
      return;
    }

    const CAPACITY = 256;

    const sprites = new FeatureSprites(TexturedSpriteKind, {capacity: CAPACITY, textures: {colorMap: texture}});

    // the constructor always creates a FeatureSpritesMaterial; only dispose() takes it away again
    const material = sprites.material!;

    material.depthFunc = LessEqualDepth; // AlwaysDepth;
    material.depthWrite = true;
    material.depthTest = true;

    // the .render-as-billboards element is written by the markup of this very page
    const listening = new AbortController();
    document.querySelector(`.${RENDER_AS_BILLBOARDS}`)!.addEventListener(
      'pointerdown',
      (e) => {
        const el = e.currentTarget as HTMLElement;
        const dataValue = el.getAttribute(`data-${RENDER_AS_BILLBOARDS}`) === 'true';

        sprites.placement = dataValue ? BillboardPlacement : FlatPlacement;

        el.setAttribute(`data-${RENDER_AS_BILLBOARDS}`, String(!dataValue));
        if (dataValue) {
          el.textContent = 'render as sprites';
        } else {
          el.textContent = 'render as billboards';
        }
      },
      {signal: listening.signal},
    );

    // a FeatureSprites has no pool only after its dispose(), and these sprites were just built
    const spritePool = sprites.spritePool!;

    const bouncingSprites = new BouncingSprites(spritePool, tileSet.atlas, 100, 75, 4, CAPACITY);
    bouncingSprites.shouldRotate = false;

    bouncingSprites.createSprites();

    demo.scene.add(sprites);

    demo.onRenderFrame(({deltaTime}) => {
      bouncingSprites.animate(deltaTime);
      sprites.update();
    });

    demo.onDispose(() => {
      listening.abort();
      // the sprites release the geometry and the material they built; the store lent the texture
      sprites.dispose();
      store.dispose();
    });

    // biome-ignore lint/suspicious/noConsole: the demo logs to the devtools on purpose
    console.log('bouncingSprites', bouncingSprites);
    // biome-ignore lint/suspicious/noConsole: the demo logs to the devtools on purpose
    console.log('FeatureSprites', sprites);
  });

  demo.start();
</script>
