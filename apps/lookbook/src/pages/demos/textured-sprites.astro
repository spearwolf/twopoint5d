---
import Layout from '~layouts/VanillaDemo.astro';
import {description, title} from './_textured-sprites.json';
---

<Layout title={title} description={description}>
  <canvas id="canvas-container" resize-to="window"></canvas>

  <section class="fixed top-20 right-4 flex flex-wrap gap-1 items-center content-center justify-center">
    <div class="actionBtn render-as-billboards select-none" data-render-as-billboards="true">render as billboards</div>
  </section>
</Layout>

<style>
  body {
    height: 100vh;
    overflow-y: hidden;
    background: radial-gradient(circle, rgb(175 82 82) 0%, rgb(90 148 191) 100%);
    color: #eee;
    font-family: sans-serif;
    font-size: 16px;
    line-height: 2;
  }
  .actionBtn {
    padding: 0.5em;
    background-color: rgba(50 20 90 / 60%);
    color: #eee;
    border-radius: 4px;
    border: 1px solid rgba(11, 15, 17);
    box-shadow: 4px 4px 0 rgba(11, 15, 17);
    font-size: 100%;
    font-weight: bold;
    cursor: pointer;
    display: inline-flex;
  }
</style>

<script>
  import {TexturedSprites, TextureStore} from '@spearwolf/twopoint5d';
  import {LessEqualDepth} from 'three/webgpu';
  import {BouncingSprites} from '~demos/textured-sprites/BouncingSprites';
  import {PerspectiveOrbitDemo} from '~demos/utils/PerspectiveOrbitDemo';
  import assetsUrl from '~demos/utils/assetsUrl';

  const RENDER_AS_BILLBOARDS = 'render-as-billboards';

  // the <canvas id="canvas-container"> is written by the markup of this very page
  const demo = new PerspectiveOrbitDemo(document.getElementById('canvas-container')!, {antialias: false});

  demo.onInit(async ({renderer}) => {
    const store = new TextureStore(renderer);
    // the catalog of the lookbook, public/assets/textures.json, names the image, tile set and texture classes of each item
    await store.loadAsync(assetsUrl('textures.json'));
    const [tileSet, texture] = await store.getAsync('skinballTiles', ['tileSet', 'texture']);

    const CAPACITY = 256;

    const sprites = new TexturedSprites(CAPACITY, texture);

    // the constructor always creates a TexturedSpritesMaterial; only dispose() takes it away again
    const material = sprites.material!;

    material.depthFunc = LessEqualDepth; // AlwaysDepth;
    material.depthWrite = true;
    material.depthTest = true;

    // the .render-as-billboards element is written by the markup of this very page
    document.querySelector(`.${RENDER_AS_BILLBOARDS}`)!.addEventListener('pointerdown', (e) => {
      const el = e.currentTarget as HTMLElement;
      const dataValue = el.getAttribute(`data-${RENDER_AS_BILLBOARDS}`) === 'true';

      material.renderAsBillboards = dataValue;

      el.setAttribute(`data-${RENDER_AS_BILLBOARDS}`, String(!dataValue));
      if (dataValue) {
        el.textContent = 'render as sprites';
      } else {
        el.textContent = 'render as billboards';
      }
    });

    const spritePool = sprites.spritePool;
    if (spritePool == null) return; // the sprites were disposed

    const bouncingSprites = new BouncingSprites(spritePool, tileSet.atlas, 100, 75, 4, CAPACITY);
    bouncingSprites.shouldRotate = false;

    bouncingSprites.createSprites();

    demo.scene.add(sprites);

    demo.onRenderFrame(({deltaTime}) => {
      bouncingSprites.animate(deltaTime);
      sprites.update();
    });

    // eslint-disable-next-line no-console
    console.log('bouncingSprites', bouncingSprites);
    // eslint-disable-next-line no-console
    console.log('TexturedSprites', sprites);
  });

  demo.start();
</script>
