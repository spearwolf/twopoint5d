---
import Layout from '~layouts/VanillaDemo.astro';
import {description, title} from './_stage-masks-matte-ink.json';
---

<Layout title={title} description={description} fullscreenCanvas>
  <demo-ui></demo-ui>
</Layout>

<style>
  body {
    background: #000;
  }
</style>

<script>
  import {
    Display,
    matte,
    StageDirector,
    type StageDirectorShape,
    StageMask,
    type StageTransitionEasing,
  } from '@spearwolf/twopoint5d';
  import GUI from 'lil-gui';
  import {Color} from 'three/webgpu';
  import {DrownedHall, loadDrownedHouseAssets, TitleCard} from '~demos/stage-masks/DrownedHouse';
  import {InkBlotLayout, InkBlots, WetEdge} from '~demos/stage-masks/InkWell';
  import {TransitionCycler} from '~demos/stage-masks/TransitionCycler';
  import {catchPrecompile, onDemoInit} from '~demos/utils/demoInit';
  import {deferPreview} from '~demos/utils/demoPreview';
  import {getDemoUi} from '~demos/utils/demoUi';
  import {getFullscreenCanvas} from '~demos/utils/fullscreenCanvas';

  // how long a scene holds before the ink takes it back, while "cycle" is on, in seconds
  const HOLD = 2.6;
  // how long the card of the lookbook waits for the fog to drift in and the eyes to find the lantern, in ms
  const PREVIEW_SETTLE = 2500;

  const isPreview = new URLSearchParams(location.search).get('preview') === '1';
  const preview = deferPreview();
  const canvas = getFullscreenCanvas();
  canvas.style.touchAction = 'none';
  const display = new Display(canvas);
  const director = new StageDirector(display).setClearColor(new Color('#000000'), 1);

  const settings = {
    duration: 3.2,
    easing: 'ease-in' as StageTransitionEasing,
    cycle: true,
    wetEdge: true,
    scrub: false,
    progress: 0.45,
  };

  onDemoInit(display, 'stage-masks-matte-ink', async ({renderer}) => {
    const assets = await loadDrownedHouseAssets(renderer);
    if (display.isDisposed) {
      assets.store.dispose();
      return;
    }

    const title = new TitleCard(assets);
    const hall = new DrownedHall(assets);

    // the ink: one layout of blots, read by the mask stage and by the wet edge above the slot.
    // The mask stage is never in the stack: matte() names its mask, and the director draws the ink
    // only while a transition through it runs
    const layout = new InkBlotLayout(1931);
    const blots = new InkBlots(layout);
    const ink = new StageMask(blots.stage, {source: 'alpha'});
    blots.bind(ink);
    const edge = new WetEdge(layout);
    edge.bind(ink);
    // 'coverage' mode: the picture of the ink is the share of `to` — made once and reused
    const inkIn = matte({mask: ink});

    director.setStack([title.stage, edge.stage]);

    // the clock of the ink runs ahead of the cycle: both its materials read it
    display.onRenderFrame(({deltaTime}) => layout.advance(deltaTime));

    // the slot between the title card and the hall: played, scrubbed by hand or cycled, with Space,
    // Enter and S
    const cycler = new TransitionCycler({
      display,
      director,
      stages: [title.stage, hall.stage],
      names: ['title card', 'the drowned hall'],
      settings,
      hold: HOLD,
      effect: () => inkIn,
      progress: () => ink.progress,
      progressName: 'ink.progress',
      onBegin: (_from, to) => {
        // a new run, new blots — but the card of the lookbook is the same every time
        if (!isPreview) layout.scatter();
        edge.running = true;
        if (to === title.stage) hall.pointer = undefined;
      },
      onEnd: () => {
        edge.running = false;
      },
    });

    const gui = new GUI({container: getDemoUi(), title: 'The Inkwell Séance'});
    gui
      .add(settings, 'wetEdge')
      .name('wet edge (a layer above)')
      .onChange(() => {
        edge.enabled = settings.wetEdge;
      });
    cycler.addControls(gui, {min: 0.4, max: 8});

    // in the hall the pointer takes the lantern over; the eyes follow it
    const onPointerMove = (event: PointerEvent) => {
      if (director.stack[0] !== hall.stage) return;
      const view = hall.stage.projection!.getViewRect();
      hall.pointer = {
        x: (event.offsetX / canvas.clientWidth - 0.5) * view.width + view.offsetX,
        y: (0.5 - event.offsetY / canvas.clientHeight) * view.height + view.offsetY,
      };
    };
    const onPointerLeave = () => {
      hall.pointer = undefined;
    };
    canvas.addEventListener('pointermove', onPointerMove);
    canvas.addEventListener('pointerleave', onPointerLeave);
    window.addEventListener('blur', onPointerLeave);

    // both shapes the slot takes — a scene alone, and the ink between two — with the ink and both
    // scenes drawn once ahead. One source and invert, so one shader of the matte
    const shapes: StageDirectorShape[] = [
      ['layer', 'layer'],
      [inkIn, 'layer'],
    ];
    const precompiled = catchPrecompile(
      'stage-masks-matte-ink',
      director.precompile(renderer, shapes, {layers: [title.stage, hall.stage, edge.stage, blots.stage]}),
    );

    // the card of the lookbook: the ink held at a frame where the blots have met
    if (isPreview) cycler.holdAt(0.55);

    let previewTimeout: ReturnType<typeof setTimeout> | undefined;

    display.onDispose(() => {
      clearTimeout(previewTimeout);
      cycler.dispose();
      window.removeEventListener('blur', onPointerLeave);
      canvas.removeEventListener('pointermove', onPointerMove);
      canvas.removeEventListener('pointerleave', onPointerLeave);
      gui.destroy();
      // the director lets go of the layers and of the mask stage first, then each goes
      director.dispose();
      ink.dispose();
      blots.dispose();
      edge.dispose();
      title.dispose();
      hall.dispose();
      assets.store.dispose();
    });

    await precompiled;
    if (display.isDisposed) return;
    previewTimeout = setTimeout(() => preview.ready(display), PREVIEW_SETTLE);
  });

  await display.start();

  Object.assign(window, {display, director});
</script>
