{
  "name": "@spearwolf/twopoint5d",
  "description": "a library to create 2.5d realtime graphics and pixelart with three.js",
  "version": "0.0.0",
  "author": "Wolfger Schramm <wolfger@spearwolf.de>",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.22.0"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "pnpm nx run-many -t build",
    "build:twopoint5d": "pnpm nx run-many -t build --projects=tag:twopoint5d",
    "rebuild:twopoint5d": "pnpm run build:twopoint5d && pnpm run test:twopoint5d",
    "test": "pnpm nx run-many -t test",
    "test:ci": "pnpm nx run-many -t test --projects=tag:ci",
    "test:browser": "pnpm nx run-many -t test --projects=tag:browser",
    "test:twopoint5d": "pnpm nx run-many -t test --projects=tag:twopoint5d",
    "test:affected": "pnpm nx affected -t test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "clean": "pnpm nx run-many -t clean && rimraf dist",
    "typecheck": "pnpm nx run-many -t typecheck",
    "checkPkgTypes": "pnpm nx run-many -t checkPkgTypes",
    "lintPkg": "pnpm nx run-many -t lintPkg",
    "publishNpmPkg": "pnpm nx run-many -t publishNpmPkg",
    "update": "pnpm dlx npm-check --update",
    "ci": "pnpm run clean && pnpm run lint && pnpm run build && pnpm run typecheck && pnpm run checkPkgTypes && pnpm run lintPkg && pnpm run test:ci && pnpm run test:browser",
    "cbt": "pnpm run ci",
    "lookbook": "pnpm nx dev lookbook"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/sinon": "^22.0.0",
    "@types/three": "catalog:",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "nx": "23.2.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "sinon": "^22.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  }
}
