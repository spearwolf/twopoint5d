{
  "name": "twopoint5d-workspace",
  "description": "Nx + pnpm workspace of @spearwolf/twopoint5d, its browser tests and the lookbook",
  "version": "0.0.0",
  "author": "Wolfger Schramm <wolfger@spearwolf.de>",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": "^24.16.0 || >=26.3.0",
    "pnpm": ">=10.22.0"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "pnpm nx run-many -t build",
    "build:twopoint5d": "pnpm nx run-many -t build --projects=tag:twopoint5d",
    "rebuild:twopoint5d": "pnpm run build:twopoint5d && pnpm run test:twopoint5d",
    "test": "pnpm nx run-many -t test",
    "test:ci": "pnpm nx run-many -t test --projects=tag:ci",
    "test:coverage": "pnpm nx run-many -t coverage",
    "test:allocations": "pnpm nx run-many -t allocations",
    "test:browser": "pnpm nx run-many -t test --projects=tag:browser",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:twopoint5d": "pnpm nx run-many -t test --projects=tag:twopoint5d",
    "test:affected": "pnpm nx affected -t test",
    "bench": "pnpm nx run-many -t bench",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "clean": "pnpm nx run-many -t clean && rimraf dist",
    "typecheck": "pnpm nx run-many -t typecheck",
    "checkPkgTypes": "pnpm nx run-many -t checkPkgTypes",
    "checkNameableTypes": "pnpm nx run-many -t checkNameableTypes",
    "lintPkg": "pnpm nx run-many -t lintPkg",
    "publishNpmPkg": "pnpm nx run-many -t publishNpmPkg",
    "update": "pnpm dlx npm-check --update",
    "ci": "pnpm run clean && pnpm run ci:checks && pnpm run test:coverage && pnpm run test:allocations && pnpm run test:browser",
    "ci:checks": "pnpm run lint && pnpm run build && pnpm run typecheck && pnpm run checkPkgTypes && pnpm run checkNameableTypes && pnpm run lintPkg && pnpm run test:scripts",
    "cbt": "pnpm run ci",
    "lookbook": "pnpm nx dev lookbook",
    "lookbook:generate-previews": "pnpm nx run lookbook:build && node scripts/lookbook/generateDemoPreviews.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "@types/sinon": "^22.0.0",
    "@types/three": "catalog:",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "nx": "23.2.1",
    "playwright": "^1.63.0",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "semver": "^7.8.5",
    "sinon": "^22.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
